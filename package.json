{
  "name": "hot-topics",
  "version": "3.0.0",
  "type": "module",
  "description": "NowTide · 自托管热榜",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler deploy",
    "kv:create": "wrangler kv namespace create KV",
    "typecheck": "tsc --noEmit",
    "test:fetchers": "node scripts/test-fetchers.mjs",
    "test": "node --test scripts/verify-nowtide.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "js-md5": "^0.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.166.0"
  }
}
